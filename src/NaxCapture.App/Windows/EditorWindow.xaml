<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="NaxCapture.App.Windows.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="BetterCapture Editor">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsAccelerator_Invoked" />
            <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
            <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number0" Modifiers="Control" Invoked="ActualSizeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar>
            <MenuBarItem x:Uid="EditorMenuFile" Title="File">
                <MenuFlyoutItem x:Uid="EditorMenuSave" Text="Save" Click="SaveButton_Click" KeyboardAcceleratorTextOverride="Ctrl+S" />
                <MenuFlyoutItem x:Uid="EditorMenuSaveAs" Text="Save as…" Click="SaveAsMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuLibrary" Text="Open library" Click="OpenLibraryMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuClose" Text="Close editor" Click="CloseMenuItem_Click" KeyboardAcceleratorTextOverride="Alt+F4" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditorMenuEdit" Title="Edit">
                <MenuFlyoutItem x:Name="UndoMenuItem" x:Uid="EditorMenuUndo" Text="Undo" Click="UndoButton_Click" KeyboardAcceleratorTextOverride="Ctrl+Z" />
                <MenuFlyoutItem x:Name="RedoMenuItem" x:Uid="EditorMenuRedo" Text="Redo" Click="RedoButton_Click" KeyboardAcceleratorTextOverride="Ctrl+Y" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuCut" Text="Cut" Click="CutButton_Click" KeyboardAcceleratorTextOverride="Ctrl+X" />
                <MenuFlyoutItem x:Uid="EditorMenuCopy" Text="Copy" Click="CopyButton_Click" KeyboardAcceleratorTextOverride="Ctrl+C" />
                <MenuFlyoutItem x:Uid="EditorMenuPaste" Text="Paste" Click="PasteButton_Click" KeyboardAcceleratorTextOverride="Ctrl+V" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuSelectAll" Text="Select all" Click="SelectAllMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                <MenuFlyoutItem x:Uid="EditorMenuDeselect" Text="Deselect" Click="DeselectMenuItem_Click" KeyboardAcceleratorTextOverride="Esc" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditorMenuImage" Title="Image">
                <MenuFlyoutItem x:Uid="EditorMenuCrop" Text="Crop" Click="CropButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuResize" Text="Resize…" Click="ResizeButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuBlur" Text="Blur area" Click="BlurButton_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditorMenuTools" Title="Tools">
                <MenuFlyoutItem x:Uid="EditorMenuSelect" Text="Selection" Click="SelectButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuText" Text="Text" Click="TextButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuWatermark" Text="Watermark" Click="WatermarkButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuArrow" Text="Arrow" Click="ArrowButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuRectangle" Text="Rectangle" Click="RectangleButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuEllipse" Text="Ellipse" Click="EllipseButton_Click" />
                <MenuFlyoutItem x:Uid="EditorMenuTriangle" Text="Triangle" Click="TriangleButton_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditorMenuView" Title="View">
                <MenuFlyoutItem x:Uid="EditorMenuZoomIn" Text="Zoom in" Click="ZoomInButton_Click" KeyboardAcceleratorTextOverride="Ctrl++" />
                <MenuFlyoutItem x:Uid="EditorMenuZoomOut" Text="Zoom out" Click="ZoomOutButton_Click" KeyboardAcceleratorTextOverride="Ctrl+-" />
                <MenuFlyoutItem x:Uid="EditorMenuActualSize" Text="Actual size" Click="ActualSizeMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                <MenuFlyoutItem x:Uid="EditorMenuFit" Text="Fit to window" Click="FitButton_Click" />
            </MenuBarItem>
            <MenuBarItem x:Uid="EditorMenuHelp" Title="Help">
                <MenuFlyoutItem x:Uid="EditorMenuShortcuts" Text="Keyboard shortcuts" Click="ShortcutsMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="EditorMenuAbout" Text="About BetterCapture Editor" Click="AboutMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="10,7" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ToggleButton x:Name="SelectButton" x:Uid="EditorSelect" Click="SelectButton_Click" Content="Select" />
                    <ToggleButton x:Name="CropButton" x:Uid="EditorCrop" Click="CropButton_Click" Content="Crop" />
                    <ToggleButton x:Name="BlurButton" x:Uid="EditorBlur" Click="BlurButton_Click" Content="Blur" />
                    <ToggleButton x:Name="TextButton" x:Uid="EditorText" Click="TextButton_Click" Content="Text" />
                    <ToggleButton x:Name="ArrowButton" x:Uid="EditorArrow" Click="ArrowButton_Click" Content="Arrow" />
                    <ToggleButton x:Name="RectangleButton" x:Uid="EditorRectangle" Click="RectangleButton_Click" Content="Rectangle" />
                    <ToggleButton x:Name="EllipseButton" x:Uid="EditorEllipse" Click="EllipseButton_Click" Content="Ellipse" />
                    <ToggleButton x:Name="TriangleButton" x:Uid="EditorTriangle" Click="TriangleButton_Click" Content="Triangle" />
                    <Button x:Name="WatermarkButton" x:Uid="EditorWatermark" Click="WatermarkButton_Click" Content="Watermark" />
                </StackPanel>
                <TextBlock x:Uid="EditorPropertiesLabel"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Properties" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                    <ComboBox x:Name="ColorCombo"
                              Width="92"
                              SelectedIndex="0"
                              SelectionChanged="TextStyle_Changed">
                        <ComboBoxItem x:Uid="ColorRed" Content="Red" Tag="Red" />
                        <ComboBoxItem x:Uid="ColorYellow" Content="Yellow" Tag="Yellow" />
                        <ComboBoxItem x:Uid="ColorWhite" Content="White" Tag="White" />
                        <ComboBoxItem x:Uid="ColorBlack" Content="Black" Tag="Black" />
                        <ComboBoxItem x:Uid="ColorBlue" Content="Blue" Tag="Blue" />
                    </ComboBox>
                    <ComboBox x:Name="FontFamilyCombo"
                              Width="180"
                              SelectionChanged="TextStyle_Changed" />
                    <NumberBox x:Name="FontSizeBox"
                               Width="90"
                               Value="28"
                               Minimum="6"
                               Maximum="300"
                               SpinButtonPlacementMode="Compact"
                               ValueChanged="FontSizeBox_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#FF111111">
            <ScrollViewer x:Name="EditorScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.1"
                          MaxZoomFactor="16">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <skia:SKXamlCanvas x:Name="EditorCanvas"
                                       PaintSurface="EditorCanvas_PaintSurface"
                                       PointerPressed="EditorCanvas_PointerPressed"
                                       PointerMoved="EditorCanvas_PointerMoved"
                                       PointerReleased="EditorCanvas_PointerReleased" />
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRectangle"
                                   Fill="#180078D4"
                                   Stroke="#FF4CC2FF"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3"
                                   Visibility="Collapsed" />
                    </Canvas>
                    <Canvas x:Name="InlineEditorCanvas">
                        <TextBox x:Name="InlineTextEditor"
                                 MinWidth="120"
                                 MinHeight="42"
                                 AcceptsReturn="True"
                                 Padding="5"
                                 BorderThickness="2"
                                 TextWrapping="Wrap"
                                 Visibility="Collapsed"
                                 LostFocus="InlineTextEditor_LostFocus"
                                 KeyDown="InlineTextEditor_KeyDown">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter"
                                                     Modifiers="Control"
                                                     Invoked="InlineTextCommitAccelerator_Invoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Padding="12,7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EditorStatusText" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Click="ZoomOutButton_Click" Content="−" />
                <TextBlock x:Name="ZoomText" Width="58" VerticalAlignment="Center" TextAlignment="Center" Text="100%" />
                <Button Click="ZoomInButton_Click" Content="+" />
                <Button x:Uid="EditorFit" Click="FitButton_Click" Content="Fit" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="BetterCapture.App.Windows.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BetterCapture Library">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="18,14" ColumnSpacing="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="LibraryHeadingText" x:Uid="LibraryWindowHeading" FontSize="23" FontWeight="SemiBold" Text="Library" />
                <TextBlock x:Name="LibraryRootText"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBox x:Name="SearchBox"
                     x:Uid="LibrarySearchBox"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     PlaceholderText="Search app, window, or filename"
                     TextChanged="SearchBox_TextChanged" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                <Button x:Name="EditSelectedButton"
                        x:Uid="LibraryEdit"
                        Click="EditSelectedButton_Click"
                        Content="Edit"
                        IsEnabled="False" />
                <Button x:Name="OpenSelectedButton"
                        x:Uid="LibraryOpen"
                        Click="OpenSelectedButton_Click"
                        Content="Open"
                        IsEnabled="False" />
                <Button x:Name="RefreshButton" x:Uid="LibraryRefresh" Click="RefreshButton_Click" Content="Refresh" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="YearLabelText" x:Uid="LibraryYearLabel" VerticalAlignment="Center" Text="Year" />
                <ComboBox x:Name="YearFilter"
                          Width="105"
                          SelectionChanged="YearFilter_SelectionChanged" />
                <TextBlock x:Name="MonthLabelText" x:Uid="LibraryMonthLabel" Margin="10,0,0,0" VerticalAlignment="Center" Text="Month" />
                <ComboBox x:Name="MonthFilter"
                          Width="180"
                          DisplayMemberPath="Display"
                          SelectionChanged="MonthFilter_SelectionChanged" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <GridView x:Name="LibraryGrid"
                      Padding="12"
                      IsItemClickEnabled="False"
                      SelectionChanged="LibraryGrid_SelectionChanged"
                      DoubleTapped="LibraryGrid_DoubleTapped"
                      ContainerContentChanging="LibraryGrid_ContainerContentChanging">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="216" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="212" Height="204"
                                Padding="7"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="126" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Background="#FF171717">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    <Border Margin="6" Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#C9000000"
                                            CornerRadius="4">
                                        <TextBlock FontSize="10" Foreground="White" Text="{Binding KindLabel}" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding CapturedAtDisplay}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Details}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <FontIcon HorizontalAlignment="Center" FontSize="42" Glyph="&#xE8B9;" />
                <TextBlock x:Name="EmptyTitleText" x:Uid="LibraryEmpty" FontSize="18" FontWeight="SemiBold" Text="No captures yet" />
                <TextBlock x:Name="EmptyHintText" x:Uid="LibraryEmptyHint"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="New screenshots and videos will appear here automatically." />
            </StackPanel>

            <ProgressRing x:Name="LoadingRing"
                          Width="42" Height="42"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Padding="14,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock x:Name="LibraryStatusText" />
        </Grid>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterCapture.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterCapture.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="22,16,22,22" Spacing="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="38"
                           Height="38"
                           VerticalAlignment="Center"
                           Source="Assets/BetterCaptureLogo-1024.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="CompactPromptText" x:Uid="CompactPrompt" FontSize="20" FontWeight="SemiBold" Text="Choose capture type" />
                        <TextBlock x:Name="CompactHintText" x:Uid="CompactHint"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The same smart selector handles windows, full screen, and custom areas." />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="9,5"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="14">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="FP16 scRGB" />
                    </Border>
                    <Button x:Name="LanguageButton"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Language">
                        <FontIcon FontSize="15" Glyph="&#xE774;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="EnglishLanguageMenuItem"
                                                      Text="English"
                                                      Tag="en-US"
                                                      Click="LanguageMenuItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="GermanLanguageMenuItem"
                                                      Text="Deutsch"
                                                      Tag="de-DE"
                                                      Click="LanguageMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsButton"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Settings">
                        <FontIcon FontSize="15" Glyph="&#xE713;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="StartupMenuItem"
                                                      Text="Start with Windows"
                                                      Click="StartupMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ShortcutMenuItem"
                                                Text="Capture shortcut: Print Screen"
                                                Click="ShortcutMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="AboutButton"
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            Click="AboutButton_Click"
                            AutomationProperties.Name="About BetterCapture">
                        <FontIcon FontSize="15" Glyph="&#xE946;" />
                    </Button>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScreenshotButton"
                            MinHeight="104"
                            HorizontalContentAlignment="Stretch"
                            Click="ScreenshotButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Padding="8" Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="23" Glyph="&#xE7C9;" />
                            <TextBlock x:Name="ScreenshotTitleText" x:Uid="ScreenshotTitle" FontSize="17" FontWeight="SemiBold" Text="Screenshot" />
                            <TextBlock x:Name="ScreenshotHintText" x:Uid="ScreenshotHint" Opacity="0.8" Text="Click a window or drag an area" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoButton"
                            Grid.Column="1"
                            MinHeight="104"
                            HorizontalContentAlignment="Stretch"
                            Click="VideoButton_Click">
                        <StackPanel Padding="8" Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="23" Glyph="&#xE714;" />
                            <TextBlock x:Name="VideoTitleText" x:Uid="VideoTitle" FontSize="17" FontWeight="SemiBold" Text="Video" />
                            <TextBlock x:Name="VideoHintText" x:Uid="VideoHint"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Record the selected window or area"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton"
                            Grid.Column="2"
                            MinHeight="104"
                            HorizontalContentAlignment="Stretch"
                            Click="LibraryButton_Click">
                        <StackPanel Padding="8" Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="23" Glyph="&#xE8B9;" />
                            <TextBlock x:Name="LibraryTitleText" x:Uid="LibraryTitle" FontSize="17" FontWeight="SemiBold" Text="Library" />
                            <TextBlock x:Name="LibraryHintText" x:Uid="LibraryHint"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Browse captures by year and month"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Padding="14,11"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CursorLabelText" x:Uid="CursorLabel"
                                   VerticalAlignment="Center"
                                   Text="Include pointer" />
                        <ToggleSwitch x:Name="CursorToggle"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsOn="True" />
                        <Button x:Name="ChangeFolderButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="ChangeFolderButton_Click"
                                Style="{StaticResource SubtleButtonStyle}">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon VerticalAlignment="Center" FontSize="17" Glyph="&#xE8B7;" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock x:Name="StorageLocationLabelText"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="Save captures to" />
                                    <TextBlock x:Name="OutputFolderText"
                                               MaxWidth="260"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" VerticalAlignment="Center" FontSize="12" Glyph="&#xE76C;" />
                            </Grid>
                        </Button>
                        <Button x:Name="OpenFolderButton"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="OpenFolderButton_Click"
                                ToolTipService.ToolTip="Open folder">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                        </Button>
                    </Grid>
                </Border>

                <InfoBar x:Name="CaptureInfo" IsClosable="True" IsOpen="False" Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BetterCapture.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BetterCapture.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="22,16,22,22" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="CompactPrompt" FontSize="20" FontWeight="SemiBold" Text="Choose capture type" />
                        <TextBlock x:Uid="CompactHint"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The same smart selector handles windows, full screen, and custom areas." />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="9,5"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="14">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="FP16 scRGB" />
                    </Border>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScreenshotButton"
                            MinHeight="104"
                            HorizontalContentAlignment="Stretch"
                            Click="ScreenshotButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Padding="8" Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="23" Glyph="&#xE7C9;" />
                            <TextBlock x:Uid="ScreenshotTitle" FontSize="17" FontWeight="SemiBold" Text="Screenshot" />
                            <TextBlock x:Uid="ScreenshotHint" Opacity="0.8" Text="Click a window or drag an area" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VideoButton"
                            Grid.Column="1"
                            MinHeight="104"
                            HorizontalContentAlignment="Stretch"
                            Click="VideoButton_Click">
                        <StackPanel Padding="8" Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="23" Glyph="&#xE714;" />
                            <TextBlock x:Uid="VideoTitle" FontSize="17" FontWeight="SemiBold" Text="Video" />
                            <TextBlock x:Uid="VideoHint"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Record the selected window or area"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Padding="14,11"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="CursorToggle" x:Uid="CursorToggle" Header="Include pointer" IsOn="True" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Uid="LibraryLabel" FontSize="12" FontWeight="SemiBold" Text="Library" />
                            <TextBlock x:Name="OutputFolderText"
                                       MaxWidth="230"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="OpenFolderButton"
                                    x:Uid="OpenFolderButton"
                                    Click="OpenFolderButton_Click"
                                    ToolTipService.ToolTip="Open folder">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            </Button>
                            <Button x:Name="ChangeFolderButton"
                                    x:Uid="ChangeFolderButton"
                                    Click="ChangeFolderButton_Click"
                                    ToolTipService.ToolTip="Change location">
                                <FontIcon FontSize="14" Glyph="&#xE713;" />
                            </Button>
                            <Button x:Name="LibraryButton"
                                    Click="LibraryButton_Click"
                                    ToolTipService.ToolTip="Open library">
                                <FontIcon FontSize="14" Glyph="&#xE8B9;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="HotkeyInfo" x:Uid="HotkeyInfo"
                         IsClosable="False" IsOpen="True" Severity="Informational"
                         Title="Print Screen" Message="Registering shortcut…" />
                <InfoBar x:Name="CaptureInfo" IsClosable="True" IsOpen="False" Severity="Success" />

                <Border Padding="12,9" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                        <TextBlock x:Name="StatusText" x:Uid="StatusText"
                                   Grid.Column="1" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Text="Ready" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
